# Local development only. Copy to .env.local and supply your own values.
# Never commit real database credentials or API tokens.

# Neon Postgres connection string (server-side only)
DATABASE_URL=

# Neon Auth base URL; use the endpoint from your Neon project
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_AUTH_URL=/api/auth

# Mapbox public browser token and server-side token
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SECRET_TOKEN=

# App origin; register it as an allowed Neon Auth origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Mapbox style override
NEXT_PUBLIC_MAPBOX_STYLE_URL=
